#SPATIAL_GRID.ascii 1
SimpleGridDB {
  num-x = 3
  num-y = 5
  num-z = 0
  space-dim = 2
  num-values = 1
  value-names = temperature
  value-units = K
  cs-data = cartesian {
    to-meters = 1.0e+3
    space-dim = 2
  }
}
// x-coordinates (km)
-20.0  0.0  20.0
// y-coordinates (km) - depth (negative below surface)
-20.0  -15.0  -10.0  -5.0  0.0
// z-coordinates (none for 2D)

// data: x, y, temperature
// Linear geothermal gradient: 15 K/km
// Surface temperature: 300 K, Bottom (20 km): 600 K
-20.0  -20.0   600.0
  0.0  -20.0   600.0
 20.0  -20.0   600.0
-20.0  -15.0   525.0
  0.0  -15.0   525.0
 20.0  -15.0   525.0
-20.0  -10.0   450.0
  0.0  -10.0   450.0
 20.0  -10.0   450.0
-20.0   -5.0   375.0
  0.0   -5.0   375.0
 20.0   -5.0   375.0
-20.0    0.0   300.0
  0.0    0.0   300.0
 20.0    0.0   300.0
