#SPATIAL_GRID.ascii 1
SimpleGridDB {
  num-x = 5
  num-y = 5
  num-z = 0
  space-dim = 2
  num-values = 1
  value-names = temperature
  value-units = K
  cs-data = cartesian {
    to-meters = 1.0e+3
    space-dim = 2
  }
}
// x-coordinates (km)
-10.0  -2.0  0.0  2.0  10.0
// y-coordinates (km) - depth (negative below surface)
-10.0  -7.5  -5.0  -2.5  0.0
// z-coordinates (none for 2D)

// data: x, y, temperature
// Geothermal gradient with a hot perturbation at x=0, y=-5 km
// Perturbation: +30 K at center
//
// Row 1: y = -10 km (bottom)
-10.0  -10.0   450.0
 -2.0  -10.0   450.0
  0.0  -10.0   450.0
  2.0  -10.0   450.0
 10.0  -10.0   450.0
// Row 2: y = -7.5 km
-10.0   -7.5   412.5
 -2.0   -7.5   420.0
  0.0   -7.5   425.0
  2.0   -7.5   420.0
 10.0   -7.5   412.5
// Row 3: y = -5 km (center of perturbation)
-10.0   -5.0   375.0
 -2.0   -5.0   390.0
  0.0   -5.0   405.0
  2.0   -5.0   390.0
 10.0   -5.0   375.0
// Row 4: y = -2.5 km
-10.0   -2.5   337.5
 -2.0   -2.5   345.0
  0.0   -2.5   350.0
  2.0   -2.5   345.0
 10.0   -2.5   337.5
// Row 5: y = 0 km (surface)
-10.0    0.0   300.0
 -2.0    0.0   300.0
  0.0    0.0   300.0
  2.0    0.0   300.0
 10.0    0.0   300.0
