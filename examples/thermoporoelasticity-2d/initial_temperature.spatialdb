#SPATIAL_GRID.ascii 1
SimpleGridDB {
  num-x = 3
  num-y = 5
  num-z = 0
  space-dim = 2
  num-values = 1
  value-names = temperature
  value-units = K
  cs-data = cartesian {
    to-meters = 1.0e+3
    space-dim = 2
  }
}
// x-coordinates (km)
-10.0  0.0  10.0
// y-coordinates (km) - depth (negative below surface)
-10.0  -7.5  -5.0  -2.5  0.0
// z-coordinates (none for 2D)

// data: x, y, temperature
// Linear geothermal gradient: 15 K/km
// Surface temperature: 300 K, Bottom (10 km): 450 K
-10.0  -10.0   450.0
