#SPATIAL_GRID.ascii 1
SimpleGridDB {
  num-x = 5
  num-y = 5
  num-z = 0
  space-dim = 2
  num-values = 1
  value-names = temperature
  value-units = K
  cs-data = cartesian {
    to-meters = 1.0e+3
    space-dim = 2
  }
}
// x-coordinates (km) - includes points for temperature perturbation
-20.0  -5.0  0.0  5.0  20.0
// y-coordinates (km) - depth (negative below surface)
-20.0  -15.0  -10.0  -5.0  0.0
// z-coordinates (none for 2D)

// data: x, y, temperature
// This represents an initial temperature field with a hot perturbation
// at depth, simulating a thermal anomaly (e.g., from magma or shear heating).
//
// Background geothermal gradient: 15 K/km
// Surface temperature: 300 K, Bottom (20 km): 600 K
// Thermal anomaly: +50 K at 10 km depth, centered at x=0
//
// Row 1: y = -20 km (bottom)
-20.0  -20.0   600.0
 -5.0  -20.0   600.0
  0.0  -20.0   600.0
  5.0  -20.0   600.0
 20.0  -20.0   600.0
// Row 2: y = -15 km
-20.0  -15.0   525.0
 -5.0  -15.0   535.0
  0.0  -15.0   545.0
  5.0  -15.0   535.0
 20.0  -15.0   525.0
// Row 3: y = -10 km (center of thermal anomaly)
-20.0  -10.0   450.0
 -5.0  -10.0   475.0
  0.0  -10.0   500.0
  5.0  -10.0   475.0
 20.0  -10.0   450.0
// Row 4: y = -5 km
-20.0   -5.0   375.0
 -5.0   -5.0   390.0
  0.0   -5.0   405.0
  5.0   -5.0   390.0
 20.0   -5.0   375.0
// Row 5: y = 0 km (surface, fixed at 300 K)
-20.0    0.0   300.0
 -5.0    0.0   300.0
  0.0    0.0   300.0
  5.0    0.0   300.0
 20.0    0.0   300.0
