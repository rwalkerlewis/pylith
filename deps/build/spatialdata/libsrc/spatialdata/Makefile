distclean-generic:
	-test -z "$(CONFIG_CLEAN_FILES)" || rm -f $(CONFIG_CLEAN_FILES)
	-test . = "$(srcdir)" || test -z "$(CONFIG_CLEAN_VPATH_FILES)" || rm -f $(CONFIG_CLEAN_VPATH_FILES)
	-rm -f geocoords/$(DEPDIR)/$(am__dirstamp)
	-rm -f geocoords/$(am__dirstamp)
	-rm -f muparser/$(DEPDIR)/$(am__dirstamp)
	-rm -f muparser/$(am__dirstamp)
	-rm -f spatialdb/$(DEPDIR)/$(am__dirstamp)
	-rm -f spatialdb/$(am__dirstamp)
	-rm -f units/$(DEPDIR)/$(am__dirstamp)
	-rm -f units/$(am__dirstamp)
	-rm -f utils/$(DEPDIR)/$(am__dirstamp)
	-rm -f utils/$(am__dirstamp)

maintainer-clean-generic:
	@echo "This command is intended for maintainers to use"
	@echo "it deletes files that may require special tools to rebuild."
clean: clean-recursive

clean-am: clean-generic clean-libLTLIBRARIES clean-libtool \
	mostlyclean-am

